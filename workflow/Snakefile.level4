JSON_2011 = "Cert_160404-180252_7TeV_ReRecoNov08_Collisions11_JSON.txt"
JSON_2012 = "Cert_190456-208686_8TeV_22Jan2013ReReco_Collisions12_JSON.txt"

# recid of each CERN Open Data record the dataset was fetched from, and the
# chunk count produced by `make_chunks.py` for each (see fetch_file_index.py
# and workflow/chunks_<dataset>.json), kept here for traceability:
#   DoubleMu_Run2011A        recid 17    5 chunks  (JSON_2011)
#   DoubleElectron_Run2011A  recid 16    6 chunks  (JSON_2011)
#   DoubleMuParked_Run2012B  recid 6004  8 chunks  (JSON_2012)
#   DoubleMuParked_Run2012C  recid 6030 10 chunks  (JSON_2012)
#   DoubleElectron_Run2012B  recid 6003  6 chunks  (JSON_2012)
#   DoubleElectron_Run2012C  recid 6029  8 chunks  (JSON_2012)
#
# Rule input/output/params must be static (plain strings/lists with
# {wildcards}), not Python functions or lambdas: reana-client serializes
# each rule to JSON when creating the workflow, and "Object of type function
# is not JSON serializable" is fatal there. That's why analyze_chunk is
# split in two by year (static JSON filename per rule, picked via
# wildcard_constraints) instead of a params lambda, and why merge_dataset is
# unrolled per dataset with a precomputed chunk_id list instead of an input
# function reading workflow/chunks_<dataset>.json at DAG-build time.
#
# The 43 analyze_chunk jobs (~4h each at the measured 45s/file) all run on
# Kubernetes, like every other step. CERN HTCondor would offer far more
# parallel slots, but the htcondorcern backend on reana.cern.ch 0.9.4 cannot
# run these jobs: a docker.io CMSSW image dies at once because the image
# ENTRYPOINT cds into $CMSSW_BASE/src before HTCondor's relative
# ./job_wrapper.sh is resolved (reana-job-controller#531), and a
# /cvmfs/unpacked.cern.ch/... image with unpacked_img=True -- the documented
# way around that -- just hangs in `running` forever with no logs on 0.9.4
# (confirmed with a one-line helloworld). The REANA-side fix is expected in
# the 0.95.0 release; once reana.cern.ch ships it, move analyze_chunk_2011 and
# analyze_chunk_2012 back to htcondorcern with a /cvmfs image and
# `compute_backend="htcondorcern", htcondor_max_runtime="tomorrow",
# unpacked_img=True` in resources (CERN_USER/CERN_KEYTAB are already uploaded
# as secrets; the backend injects the Kerberos token itself).
#
# On Kubernetes the CMSSW image comes from Docker Hub, pulled once per cluster.
# The analyze_chunk jobs ask for kubernetes_memory_limit="8Gi" (server max is
# 9.5Gi): the first full run at 4Gi finished 42/43 chunks in ~4h each, but
# DoubleMuParked_Run2012C/chunk_0006 ran ~19h and then failed with no logs --
# the signature of an OOM-kill once cmsRun's memory crept past the limit over a
# 320-file chunk. The short steps (scram, merge, combine, make_plot) keep the
# default and share the CMSSW build area living in the workspace.

rule all:
    input:
        "results/mass4l_combine_user.pdf"

rule scram:
    input:
        config["data"],
        config["code"]
    output:
        touch("results/scramdone.txt"),
        directory("CMSSW_5_3_32")
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    shell:
        "source /opt/cms/cmsset_default.sh "
        "&& scramv1 project CMSSW CMSSW_5_3_32 "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& cp -r ../../code/HiggsExample20112012 . "
        "&& cd HiggsExample20112012/HiggsDemoAnalyzer "
        "&& scram b "
        "&& cd ../Level4 "
        "&& mkdir -p ../../../../results "

rule analyze_chunk_2011:
    input:
        config["data"],
        config["code"],
        "workflow/chunk_lists/{dataset}/{chunk_id}.txt"
    output:
        "results/chunks/{dataset}/{chunk_id}.root"
    wildcard_constraints:
        dataset="DoubleMu_Run2011A|DoubleElectron_Run2011A"
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    resources:
        kubernetes_memory_limit="8Gi"
    shell:
        "WORKDIR=$(pwd) "
        "&& mkdir -p work_{wildcards.dataset}_{wildcards.chunk_id} "
        "&& cd work_{wildcards.dataset}_{wildcards.chunk_id} "
        "&& source /opt/cms/cmsset_default.sh "
        "&& scramv1 project CMSSW CMSSW_5_3_32 "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& cp -r $WORKDIR/code/HiggsExample20112012 . "
        "&& cd HiggsExample20112012/HiggsDemoAnalyzer "
        "&& scram b "
        "&& cd ../Level4 "
        "&& mkdir -p $WORKDIR/results/chunks/{wildcards.dataset} "
        "&& cp $WORKDIR/workflow/chunk_lists/{wildcards.dataset}/{wildcards.chunk_id}.txt this_chunk_index.txt "
        "&& sed "
        "-e 's|/home/cms-opendata/CMSSW_5_3_32/src/Demo/DemoAnalyzer/datasets/CMS_Run2012C_DoubleMuParked_AOD_22Jan2013-v1_10000_file_index.txt|this_chunk_index.txt|' "
        "-e \"s|/home/cms-opendata/CMSSW_5_3_32/src/Demo/DemoAnalyzer/datasets/Cert_190456-208686_8TeV_22Jan2013ReReco_Collisions12_JSON.txt|$WORKDIR/data/Cert_160404-180252_7TeV_ReRecoNov08_Collisions11_JSON.txt|\" "
        "-e \"s|'HiggsDemoAnalyzer'|'HiggsDemoAnalyzerGit'|\" "
        "demoanalyzer_cfg_level4data.py > demoanalyzer_cfg_level4data_chunk.py "
        "&& cmsRun demoanalyzer_cfg_level4data_chunk.py "
        "&& cp *.root $WORKDIR/results/chunks/{wildcards.dataset}/{wildcards.chunk_id}.root"

rule analyze_chunk_2012:
    input:
        config["data"],
        config["code"],
        "workflow/chunk_lists/{dataset}/{chunk_id}.txt"
    output:
        "results/chunks/{dataset}/{chunk_id}.root"
    wildcard_constraints:
        dataset="DoubleMuParked_Run2012B|DoubleMuParked_Run2012C|DoubleElectron_Run2012B|DoubleElectron_Run2012C"
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    resources:
        kubernetes_memory_limit="8Gi"
    shell:
        "WORKDIR=$(pwd) "
        "&& mkdir -p work_{wildcards.dataset}_{wildcards.chunk_id} "
        "&& cd work_{wildcards.dataset}_{wildcards.chunk_id} "
        "&& source /opt/cms/cmsset_default.sh "
        "&& scramv1 project CMSSW CMSSW_5_3_32 "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& cp -r $WORKDIR/code/HiggsExample20112012 . "
        "&& cd HiggsExample20112012/HiggsDemoAnalyzer "
        "&& scram b "
        "&& cd ../Level4 "
        "&& mkdir -p $WORKDIR/results/chunks/{wildcards.dataset} "
        "&& cp $WORKDIR/workflow/chunk_lists/{wildcards.dataset}/{wildcards.chunk_id}.txt this_chunk_index.txt "
        "&& sed "
        "-e 's|/home/cms-opendata/CMSSW_5_3_32/src/Demo/DemoAnalyzer/datasets/CMS_Run2012C_DoubleMuParked_AOD_22Jan2013-v1_10000_file_index.txt|this_chunk_index.txt|' "
        "-e \"s|/home/cms-opendata/CMSSW_5_3_32/src/Demo/DemoAnalyzer/datasets/Cert_190456-208686_8TeV_22Jan2013ReReco_Collisions12_JSON.txt|$WORKDIR/data/Cert_190456-208686_8TeV_22Jan2013ReReco_Collisions12_JSON.txt|\" "
        "-e \"s|'HiggsDemoAnalyzer'|'HiggsDemoAnalyzerGit'|\" "
        "demoanalyzer_cfg_level4data.py > demoanalyzer_cfg_level4data_chunk.py "
        "&& cmsRun demoanalyzer_cfg_level4data_chunk.py "
        "&& cp *.root $WORKDIR/results/chunks/{wildcards.dataset}/{wildcards.chunk_id}.root"

rule merge_DoubleMu_Run2011A:
    input:
        "results/scramdone.txt",
        "CMSSW_5_3_32",
        expand(
            "results/chunks/DoubleMu_Run2011A/{c}.root",
            c=["chunk_0000", "chunk_0001", "chunk_0002", "chunk_0003", "chunk_0004"],
        )
    output:
        "results/DoubleMu_Run2011A_full.root"
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    shell:
        "source /opt/cms/cmsset_default.sh "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& hadd -f ../../{output} ../../results/chunks/DoubleMu_Run2011A/*.root"

