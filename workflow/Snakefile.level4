# The analysis strategy (see README) reads the 4mu and 2mu2e final states from
# the DoubleMu(Parked) primary datasets and the 4e final state from the
# DoubleElectron primary datasets, to avoid double-counting from overlapping
# triggers. 2012 has two eras (B+C) per primary dataset that get combined into
# one file; 2011 has only era A, so its merge_dataset output is used directly.

rule combine_2012_muon_v2:
    input:
        "results/DoubleMuParked_Run2012B_full.root",
        "results/DoubleMuParked_Run2012C_full.root",
        "results/scramdone.txt",
        "CMSSW_5_3_32"
    output:
        "results/DoubleMu12_combined.root"
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    shell:
        "source /opt/cms/cmsset_default.sh "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& hadd -f ../../{output} ../../{input[0]} ../../{input[1]}"

rule combine_2012_electron_v2:
    input:
        "results/DoubleElectron_Run2012B_full.root",
        "results/DoubleElectron_Run2012C_full.root",
        "results/scramdone.txt",
        "CMSSW_5_3_32"
    output:
        "results/DoubleE12_combined.root"
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    shell:
        "source /opt/cms/cmsset_default.sh "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& hadd -f ../../{output} ../../{input[0]} ../../{input[1]}"

rule make_plot:
    input:
        config["data"],
        config["code"],
        "results/scramdone.txt",
        "CMSSW_5_3_32",
        "results/DoubleMu12_combined.root",
        "results/DoubleE12_combined.root",
        "results/DoubleMu_Run2011A_full.root",
        "results/DoubleElectron_Run2011A_full.root"
    output:
        "results/mass4l_combine_user.pdf"
    container:
        "docker://docker.io/cmsopendata/cmssw_5_3_32"
    shell:
        "source /opt/cms/cmsset_default.sh "
        "&& cd CMSSW_5_3_32/src "
        "&& eval `scramv1 runtime -sh` "
        "&& cd HiggsExample20112012/HiggsDemoAnalyzer "
        "&& cd ../Level4 "
        "&& cp ../../../../data/*.root . "
        "&& cp ../../../../results/DoubleMu12_combined.root DoubleMu12.root "
        "&& cp ../../../../results/DoubleE12_combined.root DoubleE12.root "
        "&& cp ../../../../results/DoubleMu_Run2011A_full.root DoubleMu11.root "
        "&& cp ../../../../results/DoubleElectron_Run2011A_full.root DoubleE11.root "
        "&& root -b -l -q ./M4Lnormdatall.cc "
        "&& cp mass4l_combine_user.pdf ../../../../results/"
